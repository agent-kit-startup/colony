{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Colony",
  "mainBinaryName": "colony",
  "version": "0.1.0",
  "identifier": "io.missionkit.colony",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; frame-src http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "Mission Kit Colony desktop IDE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBOUJCNDM0OUMyMjQ4QzYKUldUR1NDS2NOTFNibXRyNjlqR3cvQmRWREpQZXFWVUpGWll1ZVBGbFFIMDYyNkdIZ1BweGRhbFYK",
      "endpoints": ["https://github.com/agent-kit-startup/colony/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
